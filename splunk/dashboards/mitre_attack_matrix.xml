  <row>
    <panel>
      <chart>
        <title>Detection Events by MITRE Tactic (24h)</title>
        <search>
          <query>
            index=sysmon OR index=wineventlog
            | eval tactic=case(
                EventCode=4625 OR (EventCode=10 AND TargetImage="*lsass*"), "Credential Access",
                EventCode=1 AND (Image="*powershell*" OR Image="*cmd.exe*" OR Image="*wscript*"), "Execution",
                EventCode=1 AND Image="*schtasks*", "Persistence",
                EventCode=13 AND TargetObject="*ms-settings*", "Privilege Escalation",
                EventCode=3, "Command and Control",
                EventCode=1 AND (Image="*rundll32*" OR Image="*regsvr32*"), "Defense Evasion",
                EventCode=1 AND (CommandLine="*whoami*" OR CommandLine="*systeminfo*" OR CommandLine="*ipconfig*"), "Discovery",
                1=1, "Other")
            | where tactic!="Other"
            | stats count by tactic
            | sort -count
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.drilldown">none</option>
        <option name="charting.chart.showDataLabels">all</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Detection Events Timeline by Technique</title>
        <search>
          <query>
            index=sysmon OR index=wineventlog
            | eval technique=case(
                EventCode=4625, "T1110-Brute Force",
                EventCode=1 AND Image="*powershell*", "T1059.001-PowerShell",
                EventCode=1 AND Image="*schtasks*", "T1053-Scheduled Task",
                EventCode=10 AND TargetImage="*lsass*", "T1003-Credential Dump",
                EventCode=13 AND TargetObject="*ms-settings*", "T1548-UAC Bypass",
                1=1, "Other")
            | where technique!="Other"
            | timechart span=1h count by technique
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.drilldown">none</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
  </row>
</dashboard>
